   ],
   "source": [
    "#数据准备\n",
    "x = np.linspace(-10,10,1000)\n",
    "y = np.sin(x)\n",
    "#创建画布\n",
    "plt.figure(figsize=(20,8),dpi=100)\n",
    "#绘图\n",
    "plt.plot(x,y)\n",
    "#添加网格\n",
    "plt.grid()\n",
    "#展示\n",
    "plt.show()"
   ]
